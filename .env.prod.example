# ====================================================================
# .env.prod.example — 운영 환경 변수 템플릿 (C Week 3 Day 4, 2026-05-12)
#
# 사용:
#   cp projects/.env.prod.example projects/.env.prod
#   # 실제 값 채운 뒤
#   docker compose -f projects/docker-compose.prod.yml --env-file projects/.env.prod up -d
#
# 보안:
#   - .env.prod 는 .gitignore. 절대 커밋 금지.
#   - JWT_SECRET_KEY / POSTGRES_PASSWORD / STRIPE_SECRET_KEY 는 32+ byte 무작위.
#   - STRIPE_WEBHOOK_SECRET 은 Stripe Dashboard > Developers > Webhooks 에서 발급.
# ====================================================================

# ── 데이터베이스 / 인프라 ───────────────────────────────────────────────
POSTGRES_USER=coops_prod
POSTGRES_PASSWORD=replace-with-strong-32byte-random
POSTGRES_DB=coops_prod
JWT_SECRET_KEY=replace-with-jwt-secret-32byte-random

# ── LLM Provider (기본 로컬 LM Studio. cloud fallback 시 키 추가) ──────
LLM_PROVIDER=local
LLM_EMBED_PROVIDER=local
LLM_FALLBACK_ENABLED=true
LOCAL_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_API_KEY=lm-studio
LOCAL_FAST_MODEL=google/gemma-4-e4b
LOCAL_HEAVY_MODEL=google/gemma-4-26b-a4b
LOCAL_VISION_MODEL=google/gemma-4-26b-a4b
LOCAL_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
LOCAL_BACKUP_MODEL=mistralai/mistral-7b-instruct-v0.3

# Cloud fallback (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# ── Orchestrator / 청킹 (book §16.10.3) ─────────────────────────────
ORCH_COMPACT_CONTEXT=1
ORCH_CONTEXT_MAX_TOKENS=12000
CHUNKING_MAX_PARALLEL=4
CHUNKING_OVERLAP_RATIO=0.15
CHUNKING_HISTORY_MAX_TOKENS=8000
CHUNKING_CONVERSATION_RECENT_TURNS=5

# ── Stripe 결제 게이트웨이 (B-7, 기본 OFF) ───────────────────────────
# 운영 단계별 활성화:
#   1) STRIPE_ENABLED=0  → Stripe 라우트 503. 수기 admin /subscribe 만 사용.
#   2) STRIPE_ENABLED=1 + test mode (sk_test_*) → 베타 첫 인보이스 발행 후 검증.
#   3) STRIPE_ENABLED=1 + live mode (sk_live_*) → 실 결제 활성화.
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_SUCCESS_URL=https://example.com/billing/success
STRIPE_CANCEL_URL=https://example.com/billing/cancel
# 서비스별 override (선택, 미설정 시 위 공통값 사용)
COOPS_STRIPE_ENABLED=0
COOPS_STRIPE_SECRET_KEY=
COOPS_STRIPE_WEBHOOK_SECRET=
# Plan ↔ Stripe Price (scripts/seed_stripe_plan_mappings.py — cop003 plan id 기준)
COOPS_STRIPE_PRICE_ID_FREE=
COOPS_STRIPE_PRICE_ID_STARTUP=
COOPS_STRIPE_PRICE_ID_SMB=
COOPS_STRIPE_PRICE_ID_ENT=
ADK_STRIPE_SECRET_KEY=
ADK_STRIPE_WEBHOOK_SECRET=

# MEDI (D R3 D1 — medi004 plan: free / clinic / hospital / ent)
MEDI_STRIPE_ENABLED=0
MEDI_STRIPE_SECRET_KEY=
MEDI_STRIPE_WEBHOOK_SECRET=
MEDI_STRIPE_PRICE_ID_CLINIC=
MEDI_STRIPE_PRICE_ID_HOSPITAL=
MEDI_STRIPE_PRICE_ID_ENT=
MEDI_STRIPE_PRICE_ID_FREE=

# MEDI 이미지 저장 (D R3 D2)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_PREFIX=medi/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# ── 푸시 알림 (E 트랙, 기본 OFF) ──────────────────────────────────────
# 운영 단계별 활성화:
#   1) PUSH_ENABLED=0  → 등록/조회/폐기 라우트만 동작 (발송 503).
#   2) PUSH_ENABLED=1 + Expo Access Token → 베타 첫 발송.
PUSH_ENABLED=0
PUSH_EXPO_ACCESS_TOKEN=
PUSH_API_URL=https://exp.host/--/api/v2/push/send
PUSH_HTTP_DISABLED=0
# 서비스별 override (선택)
COOPS_PUSH_ENABLED=
COOPS_PUSH_EXPO_ACCESS_TOKEN=
ADK_PUSH_ENABLED=
ADK_PUSH_EXPO_ACCESS_TOKEN=

# ── OAuth 통합 (선택) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_DEFAULT_ROLE=staff

# ── 운영 관측성 (선택, observability-stack 사용 시) ──────────────────
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin
PROMETHEUS_RETENTION_DAYS=30
