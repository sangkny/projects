# docker-compose.prod.yml 예시 — 복사 후 .env.prod 로 저장
# cp .env.prod.example .env.prod

# ── LLM (운영은 클라우드 Provider 로 전환 가능) ──
LLM_PROVIDER=openai
LLM_EMBED_PROVIDER=openai
LLM_FALLBACK_ENABLED=true

# ── Local (LM Studio 등) 사용 시 ──
# LLM_PROVIDER=local
# LOCAL_BASE_URL=http://host.docker.internal:8000/v1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# ── 데이터베이스 (운영에서는 강한 비밀번호로 교체) ──
POSTGRES_USER=dev
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=mediiot
