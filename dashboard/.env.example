# Dashboard dev env — SSOT: projects/PORT-ALLOCATION.md
#
# WSL2 + Docker (docker compose -f docker-compose.dev.yml up -d):
#   medi-iot-api-dev  → localhost:8001
#   api-gateway-dev   → localhost:8090  (/dashboard/, /api/medical|code|ops/)
#   dashboard-dev     → localhost:3000  (또는 gateway /dashboard/)
#
# Vite local dev (npm run dev):
#   http://localhost:5174/dashboard/  — pronunciation-master 5173 과 분리
#
# VITE_API_URL 비우면 Vite proxy 사용 (권장)
VITE_API_URL=
VITE_GATEWAY_URL=http://localhost:8090
VITE_MEDI_API_URL=http://localhost:8001
VITE_APP_ENV=development
