        "multi": true,
        "refresh": 2,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(chunking_invocations_total, service)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      }
    ]
  },
