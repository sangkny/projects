{
  "annotations": { "list": [] },
  "description": "CoOps SaaS billing/quota 대시보드 — C Week 3 + B-7 Stripe R3 (2026-05-14). saas_calls_total … saas_stripe_webhook_events_total + R3: saas_stripe_revenue_minor_total, saas_stripe_disputes_total, saas_stripe_revenue_usd_total rate.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "사용량 (Calls & Quota)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5분 호출 수 (service 별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service) (increase(saas_calls_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "orange", "value": 500 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "호출률 (per second) — plan_code 별 stacked",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service, plan_code) (rate(saas_calls_total[1m]))",
          "legendFormat": "{{service}} / {{plan_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "stacking": { "mode": "normal", "group": "A" },
            "fillOpacity": 30
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 1 }
    },
    {
      "id": 4,
      "type": "row",
      "title": "쿼터 차단 (Quota Enforcement)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "429 차단 5분 누적 (action 별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service, action) (increase(saas_quota_blocked_total[5m]))",
          "legendFormat": "{{service}}/{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "orientation": "auto", "colorMode": "background" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "429 차단율 % (rate ratio)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 * (rate(saas_quota_blocked_total[5m]) / clamp_min(rate(saas_calls_total[5m]) + rate(saas_quota_blocked_total[5m]), 0.001))",
          "legendFormat": "{{service}}/{{plan_code}}/{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20 },
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 10 }
    },
    {
      "id": 7,
      "type": "row",
      "title": "구독 변경 (Plan Transitions)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
