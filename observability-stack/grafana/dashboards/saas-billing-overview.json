      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 5 },
              { "color": "yellow", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "orientation": "horizontal", "colorMode": "value" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 }
    },
    {
      "id": 10,
      "type": "row",
