        {
          "expr": "sum by (service, channel) (increase(saas_plan_transitions_total[1h]))",
          "legendFormat": "{{service}}/{{channel}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "stacking": { "mode": "normal", "group": "A" },
            "fillOpacity": 60
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 18 }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "현재 활성 구독 (plan 별 snapshot)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "saas_active_subscribers",
          "legendFormat": "{{service}}/{{plan_code}}",
          "refId": "A"
